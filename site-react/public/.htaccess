<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One host, one set of URLs: sptk.net and www.sptk.net share a vhost and used to
  # both answer 200, so every page existed twice for search engines. The canonical
  # tags and the sitemap all name www, so send the bare domain there permanently.
  # Must stay ahead of the rules below, or a route would be rewritten before the
  # host is corrected.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Serve the pre-rendered page for a route, e.g. /xmq_about -> /xmq_about.html.
  # Rewritten rather than redirected, so the URL stays the one the canonical tag
  # and the sitemap point at. Generated by scripts/prerender.js.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Anything else that isn't a real file falls back to the SPA shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
