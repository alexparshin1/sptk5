<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The bare sptk.net is redirected to www at the vhost level (sptk.conf and
  # sptk-le-ssl.conf on theater), not here. Rules in .htaccess run again after each
  # internal rewrite, so a redirect placed here would fire on the second pass and
  # send visitors to /xmq_about.html — an address no canonical tag points at.

  # Left for the server to handle: certbot renews the certificate through
  # /.well-known/acme-challenge/, and the SPA fallback below would answer those
  # probes with index.html instead of letting them 404 or resolve normally.
  RewriteRule ^\.well-known/ - [L]

  RewriteRule ^index\.html$ - [L]

  # Serve the pre-rendered page for a route, e.g. /xmq_about -> /xmq_about.html.
  # Rewritten rather than redirected, so the URL stays the one the canonical tag
  # and the sitemap point at. Generated by scripts/prerender.js.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Anything else that isn't a real file falls back to the SPA shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
